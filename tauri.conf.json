{
  "$schema": "https://schema.tauri.app/config/2.0.0",
  "productName": "Project Pilot Sync",
  "version": "1.0.0",
  "identifier": "com.projectpilot.sync",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "./dist"
  },
  "app": {
    "windows": [
      {
        "title": "Project Pilot Sync",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "transparent": false,
        "maximized": false,
        "visible": true,
        "decorations": true,
        "alwaysOnTop": false,
        "contentProtected": false,
        "skipTaskbar": false,
        "theme": "Auto",
        "titleBarStyle": "Visible"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png"
    ],
    "resources": [],
    "externalBin": [],
    "copyright": "",
    "category": "DeveloperTool",
    "shortDescription": "Project management and task tracking application",
    "longDescription": "A native desktop application for project management with folder opening, WhatsApp integration, email, and phone dialing capabilities.",
    "appimage": {
      "bundleMediaFramework": false
    },
    "deb": {
      "depends": []
    },
    "macOS": {
      "frameworks": [],
      "minimumSystemVersion": "10.13",
      "exceptionDomain": "",
      "signingIdentity": null,
      "providerShortName": null,
      "entitlements": null
    },
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": ""
    }
  },
  "plugins": {
    "shell": {
      "open": true,
      "scope": [
        {
          "name": "open-folder",
          "cmd": "open",
          "args": ["$FOLDER_PATH"]
        },
        {
          "name": "open-whatsapp",
          "cmd": "open",
          "args": ["whatsapp://send?phone=$PHONE"]
        },
        {
          "name": "open-email",
          "cmd": "open", 
          "args": ["mailto:$EMAIL"]
        },
        {
          "name": "open-phone",
          "cmd": "open",
          "args": ["tel:$PHONE"]
        }
      ]
    },
    "dialog": {
      "open": true,
      "save": true
    },
    "fs": {
      "scope": ["$HOME/**", "$DESKTOP/**", "$DOCUMENT/**", "$DOWNLOAD/**"]
    }
  }
}